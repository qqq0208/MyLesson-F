<scroll-view class="order-list"
             wx:if="{{orders && orders.length > 0}}"
             scroll-y="true"
             bindscrolltolower="pageMore">
    <view class="order-item"
          wx:for="{{orders}}"
          wx:for-item="order"
          wx:key="id">
        <van-divider contentPosition="left" dashed>订单号：{{order['sn']}}</van-divider>
        <van-row custom-class="title">
            <van-col span="18" class="left">
                <van-icon name="shop-collect-o"/>
                我的在线课堂官方商城
                <van-tag type="danger">直播</van-tag>
                <van-icon name="arrow"/>
            </van-col>
            <van-col span="6" class="right">
                {{order['status'] === 0 ? '未支付' : order['status'] === 1 ? '已支付' : '已取消'}}
            </van-col>
        </van-row>
        <van-swipe-cell class="body"
                        wx:if="{{order['orderDetails']}}"
                        wx:for="{{order['orderDetails']}}"
                        wx:key="id">
            <van-card price="{{item['coursePrice']}} 元"
                      origin-price="{{item['coursePrice'] / 0.8}} 元"
                      title="{{item['courseTitle']}}"
                      desc="{{item['order']['info']}}"
                      thumb="{{MINIO_COURSE_COVER}}{{item['courseCover']}}"
                      thumb-mode="scaleToFill"
                      num="1"
                      bind:tap="playVideo"
                      data-course-id="{{item['fkCourseId']}}">
            </van-card>
        </van-swipe-cell>
        <van-row custom-class="foot">
            <view class="pay-amount">
                实付款: ￥{{order['payAmount']}}
                <text class="small">.00</text>
            </view>
            <van-col span="10" class="left">更多</van-col>
            <van-col span="7" class="right">
                <van-button type="info" plain>评价订单</van-button>
            </van-col>
            <van-col span="7" class="right">
                <van-button class="remove-order-btn"
                            plain
                            type="danger"
                            bind:tap="removeOrder"
                            data-id="{{order['id']}}">
                    删除订单
                </van-button>
            </van-col>
        </van-row>
    </view>
    <view class="baseline">
        <van-divider contentPosition="center" dashed>底线</van-divider>
    </view>
</scroll-view>
<van-empty wx:else image="error" description="暂无订单记录"/>